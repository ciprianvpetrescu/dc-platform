global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: dc-cluster

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
{% for h in groups['hypervisors'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9100']
        labels:
          instance_name: '{{ h }}'
{% endfor %}

  - job_name: ceph
    static_configs:
{% for h in groups['hypervisors'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9283']
        labels:
          instance_name: '{{ h }}'
{% endfor %}

  - job_name: ceph-mon
    static_configs:
{% for h in groups['ceph_mon'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9283']
{% endfor %}
